# ScaleVexo CRM - environment template (SVX-TECH-001 section 3.3)
# Copy to .env and fill real values. Never commit .env.

# --- Django core ---
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-generate-with-secrets-token-urlsafe-64
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
APP_ORIGIN=http://localhost:5173

# --- Database ---
# Runtime application role. MUST NOT own the tables and MUST NOT have BYPASSRLS.
DATABASE_URL=postgres://svx_app:svx_app_pw@localhost:5432/svx
# Migration/owner role. Used only by `manage.py migrate`, never by the served app.
MIGRATION_DATABASE_URL=postgres://svx_owner:svx_owner_pw@localhost:5432/svx
# Scheduler role. Queue metadata only (jobs and outbox events); it cannot read
# a contact or a deal. Falls back to DATABASE_URL when unset, which the
# deployment checks warn about outside DEBUG.
SCHEDULER_DATABASE_URL=postgres://svx_scheduler:svx_sched_pw@localhost:5432/svx

# --- Credential encryption (Fernet key, base64 32 bytes) ---
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# --- Workspace defaults ---
DEFAULT_WORKSPACE_TIME_ZONE=Asia/Karachi

# --- Feature flags (Release 1 defaults: AI and connectors off) ---
FEATURE_AI_ENABLED=false
FEATURE_EMAIL_CONNECTOR_ENABLED=false

# --- AI budget controls (SVX-TECH-001 section 10.3) ---
AI_MONTHLY_CEILING_USD=2.00
AI_MAX_INPUT_TOKENS=4000
AI_MAX_OUTPUT_TOKENS=600
AI_MAX_CONCURRENT_REQUESTS=1
AI_DAILY_REQUESTS_PER_USER=20
OPENAI_API_KEY=

# --- Backups (restic) ---
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
